# ==============================================================================
# HostelMatch - Environment Variables Template
# Copy this file to .env.local and configure values for your environment.
# ==============================================================================

# MongoDB Connection String (Atlas URI)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/hostelmatch?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_for_security
JWT_EXPIRES_IN=7d

# Application Configuration (Generic for any college/university)
NEXT_PUBLIC_APP_NAME=HostelMatch

# Google Gemini API Key (Server-side only for future intelligent roommate matching)
GEMINI_API_KEY=

# Initial Admin Credentials (for seed script: npm run seed:admin)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@hostelmatch.edu
ADMIN_PASSWORD=AdminPassword123!

# Demo Student Credentials (for seed script: npm run seed:students)
DEMO_STUDENT_PASSWORD=DemoStudentPass123!
